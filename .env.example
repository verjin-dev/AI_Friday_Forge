# --- Neo4j (historical / authoritative data) ---
# Use bolt:// for a standalone server; neo4j:// is the cluster routing scheme.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- LLM gateway ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
# Set false behind a TLS-intercepting corporate proxy.
OPENAI_VERIFY_SSL=true

# --- Google Maps Platform (live traffic) ---
# Enable the Routes API on the project, not just create the key, or live calls
# return 403 and the delay model degrades to the graph baseline.
GOOGLE_MAPS_API_KEY=

# --- Public APIs ---
SEARCH_API_PROVIDER=duckduckgo
SEARCH_RESULT_LIMIT=5
SEARCH_VERIFY_SSL=true
# Set false on networks that re-sign TLS for outbound traffic.
EXTERNAL_VERIFY_SSL=true

# --- Observability (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=logipilot-ai

# --- Routing ---
# Incident severities that make a location impassable. Anything not listed
# becomes a cost penalty instead, so the engine routes around it rather than
# declaring the corridor unusable. Adding "high" here makes most of the
# delivered network impassable — see app/core/config.py.
BLOCKING_SEVERITIES=critical

# --- Platform ---
PLATFORM_DOMAIN=logistics
API_PORT=8030
LOG_LEVEL=INFO
SECURITY_DEFAULT_ROLE=analyst
WORKFLOW_MAX_REFLECTION_LOOPS=2
WORKFLOW_CONFIDENCE_THRESHOLD=0.6
