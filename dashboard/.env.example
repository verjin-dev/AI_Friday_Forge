# Browser key for Google Maps. Copy to .env.local (git-ignored) and fill in.
#
# The Google Cloud project needs BOTH of these enabled:
#   - Maps JavaScript API   (renders the map)
#   - Directions API        (draws routes and alternatives)
#
# Note: these are different products from the Routes API used by the backend
# for live traffic. Enabling one does not enable the others.
#
# Restrict the key by HTTP referrer for localhost and your production domain.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
